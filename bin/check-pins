#!/usr/bin/env python3
"""Compare each pinned plugin with its upstream default branch.

Prints one line per plugin and a compare link when upstream has moved.
Bumping a pin is a deliberate change: read the compare, then edit
.claude-plugin/marketplace.json. Exits 1 when any pin is behind, so it can
run on a schedule.
"""

import json
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent


def upstream(source):
    if source["source"] == "github":
        return f"https://github.com/{source['repo']}"
    return source["url"].removesuffix(".git")


def head(url):
    out = subprocess.run(["git", "ls-remote", url, "HEAD"], capture_output=True, text=True, check=True).stdout
    return out.split()[0]


def main():
    plugins = json.loads((ROOT / ".claude-plugin" / "marketplace.json").read_text())["plugins"]
    behind = 0
    for plugin in plugins:
        url = upstream(plugin["source"])
        pinned, latest = plugin["source"]["sha"], head(url)
        if pinned == latest:
            print(f"current  {plugin['name']}")
        else:
            behind += 1
            print(f"behind   {plugin['name']}  {url}/compare/{pinned[:12]}...{latest[:12]}")
    sys.exit(1 if behind else 0)


if __name__ == "__main__":
    main()
