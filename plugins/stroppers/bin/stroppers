#!/usr/bin/env node
// Stroppers helper CLI. Session-invoked only: every command runs, prints a
// result and exits. Exit codes: 0 ok, 1 failed or blocked, 2 usage, 3 configuration.
import { execFileSync, spawnSync } from 'node:child_process';
import { existsSync, mkdirSync, readFileSync, writeFileSync } from 'node:fs';
import { join, resolve } from 'node:path';
import { parseArgs } from 'node:util';
import { resolveConfig, explain, deliveryBlockers, ConfigError } from '../lib/config.mjs';
import { harnessForStep, selectReviewer, fallbackAllowed } from '../lib/harness.mjs';
import { ADAPTERS, adapterFor, reviewerEnv } from '../lib/adapters.mjs';
import { runReview } from '../lib/review.mjs';
import * as cp from '../lib/checkpoint.mjs';
import { verifyApproval, applyApproval, authorizeAction } from '../lib/approval.mjs';
import { fetchIssue, checkBinding, credentialRisk, upsertComment, setIssueState, checkAgent, latestCheckpointComment } from '../lib/linear.mjs';
import { triggersFor } from '../lib/triggers.mjs';
import { runFloorGuard } from '../lib/floor.mjs';
import { doctor, prepare, runBrowserVerification, cleanupAbandoned } from '../lib/playwright.mjs';
import { uploadAssets, renderIndex, checkPublishable, repoSlug, postComment, publishableSummary } from '../lib/evidence.mjs';
import { install, uninstall, installStatus, PACKAGE_VERSION } from '../lib/install.mjs';
import { writeModelMap } from '../lib/models.mjs';
import { detectSession } from '../lib/session.mjs';

const USAGE = `stroppers ${PACKAGE_VERSION}

  config validate|explain                 effective configuration (no secret values)
  doctor                                  harness, auth and binding readiness for this repo
  models                                  write the session Pstack model map and print its path
  plan triggers --base <ref> [--head <ref>]
  check floor --base <ref>
  contract validate|hash|render --file <contract.json>
  checkpoint init --issue <KEY> --contract <file> --harness <id> [--mode local|cloud]
  checkpoint show|render|summary [--phase pre-merge|delivery]
  checkpoint claim [--issue <KEY>]         restore from Linear, take and publish the lease (continuation)
  checkpoint restore --file <comment.md|->
  checkpoint stage <stage> [--reason <text>]
  checkpoint head <sha> | plan --file <plan.json> | implementer <harness>
  checkpoint outcome <criterion> --status <passed|failed|not-applicable|unverified> [--reason] [--revision] [--evidence <url>]
  checkpoint attempt <blocker-id> fix|infra [--note <text>]
  checkpoint intend <kind> <key> | complete <action-id> --result <json>
  checkpoint finding <finding-id> --disposition accepted|dismissed --reason <text>
  checkpoint lease <holder>
  linear show [--issue <KEY>]                read the issue and its comments (read-only key)
  linear post contract|checkpoint|evidence [--file <md>] [--issue <KEY>]   write as the Stroppers agent app
  linear status <status name> [--issue <KEY>]
  approval verify [--issue <KEY>]           read approval from the bound Linear workspace
  approval authorize <action> [--repository owner/name] [--environment <env>]
  review select [--implementer <harness>] [--available a,b]
  review run --base <ref> --head <ref> [--reviewer <harness>] [--implementer <harness>]
  browser doctor|prepare|run|cleanup [--grep <pattern>]
  evidence publish --run <run-id> --pr <number> [--environment <text>] [--include-traces]
  install|update [--cloud-entry] [--ref <git ref>] | uninstall | install-status   (in the target repository)

Options: --repo <path> (default: git toplevel of cwd), --json`;

const argv = process.argv.slice(2);
const { values: opt, positionals: pos } = parseArgs({
  args: argv,
  allowPositionals: true,
  strict: false,
  options: {
    repo: { type: 'string' }, json: { type: 'boolean' }, base: { type: 'string' }, head: { type: 'string' }, file: { type: 'string' },
    issue: { type: 'string' }, contract: { type: 'string' }, harness: { type: 'string' }, mode: { type: 'string' }, reason: { type: 'string' },
    status: { type: 'string' }, revision: { type: 'string' }, evidence: { type: 'string', multiple: true }, note: { type: 'string' },
    result: { type: 'string' }, disposition: { type: 'string' }, phase: { type: 'string' }, reviewer: { type: 'string' }, implementer: { type: 'string' },
    available: { type: 'string' }, repository: { type: 'string' }, environment: { type: 'string' }, grep: { type: 'string' }, run: { type: 'string' },
    pr: { type: 'string' }, 'include-traces': { type: 'boolean' }, 'cloud-entry': { type: 'boolean' }, ref: { type: 'string' }, stage: { type: 'string' }, help: { type: 'boolean' },
  },
});

function out(value, text) {
  if (opt.json || typeof text !== 'string') console.log(JSON.stringify(value, null, 2));
  else console.log(text);
}

function fail(message, code = 1) {
  console.error(`stroppers: ${message}`);
  process.exit(code);
}

function binding_owner(effective, binding) {
  return (effective.authority?.owners || []).some((o) => o.linear_user_id === binding.viewer_id);
}

function repoRoot() {
  if (opt.repo) return resolve(opt.repo);
  try {
    return execFileSync('git', ['rev-parse', '--show-toplevel'], { encoding: 'utf8', stdio: ['ignore', 'pipe', 'ignore'] }).trim();
  } catch {
    fail('not inside a git repository; pass --repo', 2);
  }
}

function config() {
  try {
    // Settings changes an owner approved as part of the contract (for example a
    // per-task reviewer). The resolver still forbids authority and binding keys.
    const approved = loadCheckpoint(false);
    const exceptions = approved?.approval?.status === 'approved' ? approved.contract.snapshot.exceptions || [] : [];
    const taskExceptions = exceptions.filter((e) => e && typeof e === 'object' && e.config).reduce((acc, e) => ({ ...acc, ...e.config }), {});
    return resolveConfig({ repoRoot: repoRoot(), taskExceptions: Object.keys(taskExceptions).length ? taskExceptions : null });
  } catch (e) {
    if (e instanceof ConfigError) fail(`invalid configuration:\n  ${e.errors.join('\n  ')}`, 3);
    throw e;
  }
}

function stateDir() {
  return join(repoRoot(), '.stroppers', 'state');
}

function checkpointPath() {
  const p = join(stateDir(), 'current.json');
  return p;
}

function loadCheckpoint(required = true) {
  const p = checkpointPath();
  if (!existsSync(p)) {
    if (required) fail('no active checkpoint in .stroppers/state; run `checkpoint init` or `checkpoint restore` from the Linear checkpoint comment');
    return null;
  }
  return JSON.parse(readFileSync(p, 'utf8'));
}

function saveCheckpoint(c) {
  mkdirSync(stateDir(), { recursive: true });
  writeFileSync(checkpointPath(), JSON.stringify(c, null, 2) + '\n');
}

function readInput(file) {
  return file === '-' ? readFileSync(0, 'utf8') : readFileSync(file, 'utf8');
}

function sessionMode() {
  return opt.mode || detectSession().mode;
}

const commands = {
  config() {
    const resolved = config();
    if (pos[1] === 'validate') return out({ ok: true, layers: resolved.layers }, `configuration is valid (${resolved.layers.map((l) => l.name).join(' < ')})`);
    if (pos[1] === 'explain') return out(explain(resolved));
    fail('config validate|explain', 2);
  },

  async doctor() {
    const { effective } = config();
    const report = { repository: repoRoot(), mode: sessionMode(), blockers: deliveryBlockers(effective), harnesses: {} };
    for (const id of Object.keys(effective.adapters)) {
      if (effective.adapters[id].enabled === false) continue;
      const a = adapterFor(effective, id);
      report.harnesses[id] = { auth: a.authCheck(reviewerEnv()), declares: a.declares };
    }
    if (!report.blockers.some((b) => b.startsWith('linear.')) && process.env[effective.linear.credential_env]) {
      try {
        const binding = await checkBinding(effective, process.env);
        report.linear = { workspace: binding.workspace_key, ok: true };
        const risk = await credentialRisk(effective, process.env, binding, (effective.authority?.owners || []).map((o) => o.linear_user_id));
        if (risk) report.blockers.push(`linear: ${risk}`);
        else report.linear.verification_key = binding_owner(effective, binding) ? 'safe: read-only (Linear refused a write probe), so approvals by its owner cannot be forged through it' : 'not an approval owner';
        const agent = await checkAgent(effective, process.env, stateDir(), (effective.authority?.owners || []).map((o) => o.linear_user_id));
        report.linear.agent = { ok: true, app_user: agent.agent_id };
      } catch (e) {
        report.blockers.push(`linear: ${e.message}`);
      }
    } else if (!report.blockers.some((b) => b.startsWith('linear.'))) report.blockers.push(`linear: ${effective.linear.credential_env} is not set in this session`);
    report.implement = harnessForStep(effective, 'implement');
    report.reviewer = selectReviewer({ config: effective, implementer: report.implement, available: Object.entries(report.harnesses).filter(([, h]) => h.auth.ok).map(([id]) => id) });
    out(report);
    if (report.blockers.length) process.exitCode = 3;
  },

  models() {
    const { effective } = config();
    out({ path: writeModelMap(stateDir(), effective) }, writeModelMap(stateDir(), effective));
  },

  plan() {
    if (pos[1] !== 'triggers' || !opt.base) fail('plan triggers --base <ref>', 2);
    out(triggersFor(repoRoot(), opt.base, opt.head || 'HEAD'));
  },

  check() {
    if (pos[1] !== 'floor' || !opt.base) fail('check floor --base <ref>', 2);
    const r = runFloorGuard({ repoRoot: repoRoot(), base: opt.base });
    out(r, `floor: ${r.status}${r.reason ? ` (${r.reason})` : ''}\n${r.output}`);
    if (r.status !== 'passed') process.exitCode = 1;
  },

  contract() {
    if (!opt.file) fail('contract validate|hash|render --file <contract.json>', 2);
    const c = JSON.parse(readInput(opt.file));
    const errors = cp.validateContract(c);
    if (errors.length) fail(`contract is invalid:\n  ${errors.join('\n  ')}`);
    if (pos[1] === 'validate') return out({ ok: true, revision: cp.contractHash(c) }, `contract is valid (${cp.contractHash(c)})`);
    if (pos[1] === 'hash') return out({ revision: cp.contractHash(c) }, cp.contractHash(c));
    if (pos[1] === 'render') return console.log(cp.renderContract(c));
    fail('contract validate|hash|render', 2);
  },

  async checkpoint() {
    const sub = pos[1];
    const { effective } = sub === 'restore' || sub === 'show' || sub === 'render' ? { effective: null } : config();
    if (sub === 'init') {
      opt.harness ||= detectSession().harness;
      if (!opt.issue || !opt.contract || !opt.harness) fail('checkpoint init --issue <KEY> --contract <file> --harness <id>', 2);
      const blockers = deliveryBlockers(effective);
      if (blockers.length) fail(`cannot start delivery:\n  ${blockers.join('\n  ')}`, 3);
      const contract = JSON.parse(readInput(opt.contract));
      const errors = cp.validateContract(contract);
      if (errors.length) fail(`contract is invalid:\n  ${errors.join('\n  ')}`);
      const existing = loadCheckpoint(false);
      if (existing && existing.task.issue_key !== opt.issue) fail(`an active checkpoint for ${existing.task.issue_key} exists; checkpoint it before starting another task in this checkout`);
      const repository = repoSlug(repoRoot());
      const c = cp.newCheckpoint({ binding: effective.linear, issue: { id: null, key: opt.issue }, repository, runId: `run-${Date.now().toString(36)}`, harness: opt.harness, mode: sessionMode(), contract });
      cp.acquireLease(c, detectSession().session || `session-${process.pid}-${Date.now().toString(36)}`);
      saveCheckpoint(c);
      return out(c, `checkpoint created for ${opt.issue} (${c.contract.revision}). Post the contract with \`contract render\` and the checkpoint with \`checkpoint render\`.`);
    }
    if (sub === 'claim') {
      // Continuation: the authoritative checkpoint is the agent app's own
      // comment for this repository. Take the lease, publish it, then re-read
      // to detect a competing session that claimed in between.
      const issueKey = opt.issue || loadCheckpoint(false)?.task?.issue_key;
      if (!issueKey) fail('checkpoint claim needs --issue', 2);
      const repository = repoSlug(repoRoot());
      const comment = await latestCheckpointComment(effective, process.env, stateDir(), issueKey, repository);
      if (!comment) fail(`no Stroppers checkpoint for ${repository} on ${issueKey}`);
      const c = cp.parse(comment.body);
      const problems = cp.validateRestored(c, { repository });
      if (problems.length) fail(`checkpoint on ${issueKey} is not usable: ${problems.join('; ')}`);
      const holder = detectSession().session || `session-${process.pid}-${Date.now().toString(36)}`;
      const lease = cp.acquireLease(c, holder);
      if (!lease.ok) fail(lease.reason);
      saveCheckpoint(c);
      await upsertComment(effective, process.env, stateDir(), issueKey, cp.render(c), { marker: cp.MARKER, repository });
      const again = cp.parse((await latestCheckpointComment(effective, process.env, stateDir(), issueKey, repository)).body);
      if (again.execution.lease?.holder !== holder) fail(`another session (${again.execution.lease?.holder}) claimed ${issueKey} at the same time; stop and let it continue`);
      const pending = cp.pendingActions(c);
      return out({ claimed: cp.taskKey(c), holder, stage: c.stage, blocked_reason: c.blocked_reason, pending_actions: pending }, `claimed ${cp.taskKey(c)} at stage ${c.stage} as ${holder}${c.blocked_reason ? `\nprevious blocked reason (re-check it, do not inherit it): ${c.blocked_reason}` : ''}${pending.length ? `\nreconcile before retrying: ${pending.map((a) => a.id).join(', ')}` : ''}`);
    }
    if (sub === 'restore') {
      const c = cp.parse(readInput(opt.file || '-').trim());
      if (!c) fail('input is not a Stroppers checkpoint comment');
      const problems = cp.validateRestored(c, { repository: repoSlug(repoRoot()) });
      if (problems.length) fail(`checkpoint is not usable: ${problems.join('; ')}`);
      saveCheckpoint(c);
      const pending = cp.pendingActions(c);
      return out({ restored: cp.taskKey(c), stage: c.stage, pending_actions: pending }, `restored ${cp.taskKey(c)} at stage ${c.stage}${pending.length ? `\nreconcile before retrying: ${pending.map((a) => a.id).join(', ')}` : ''}`);
    }
    const c = loadCheckpoint();
    if (sub === 'show') return out(c);
    if (sub === 'render') return console.log(cp.render(c));
    if (sub === 'summary') return out(cp.acceptanceSummary(c, { phase: opt.phase || 'delivery' }));
    if (sub === 'stage') cp.setStage(c, pos[2], opt.reason);
    else if (sub === 'head') cp.setHead(c, pos[2]);
    else if (sub === 'implementer') c.execution.implementer = pos[2];
    else if (sub === 'plan') c.verification_plan = JSON.parse(readInput(opt.file));
    else if (sub === 'outcome') cp.recordOutcome(c, pos[2], { status: opt.status, reason: opt.reason, revision: opt.revision || c.revision.head, evidence: opt.evidence || [], stage: c.verification_plan.find((p) => p.criterion_id === pos[2])?.stage });
    else if (sub === 'attempt') {
      const r = cp.recordAttempt(c, pos[2], pos[3], effective, opt.note || '');
      saveCheckpoint(c);
      out(r, r.escalate ? `ESCALATE: ${c.blocked_reason}` : `${pos[3]} attempt ${r.count} recorded${r.retry_after_seconds ? `; retry after ${r.retry_after_seconds}s` : ''}`);
      return;
    } else if (sub === 'intend') {
      const r = cp.intend(c, { kind: pos[2], key: pos[3] });
      saveCheckpoint(c);
      out(r, r.duplicate ? `already completed: ${r.action.id}` : r.reconcile ? `UNKNOWN OUTCOME: ${r.action.id} was intended earlier; check the remote system before retrying` : `intended ${r.action.id}`);
      if (r.duplicate || r.reconcile) process.exitCode = 1;
      return;
    } else if (sub === 'complete') cp.complete(c, pos[2], JSON.parse(opt.result || '{}'));
    else if (sub === 'finding') {
      const f = c.findings.find((x) => x.id === pos[2]);
      if (!f) fail(`no finding ${pos[2]}`);
      if (!opt.reason) fail('a disposition needs --reason with evidence');
      Object.assign(f, { disposition: opt.disposition, disposition_reason: opt.reason, disposed_at: new Date().toISOString() });
    } else if (sub === 'lease') {
      const r = cp.acquireLease(c, pos[2]);
      if (!r.ok) fail(r.reason);
    } else fail(`unknown checkpoint command ${sub}`, 2);
    saveCheckpoint(c);
    out(c, `checkpoint updated: stage ${c.stage}${c.blocked_reason ? ` (blocked: ${c.blocked_reason})` : ''}`);
  },

  async linear() {
    const { effective } = config();
    const c = loadCheckpoint(false);
    const issue = opt.issue || c?.task?.issue_key;
    if (!issue) fail('no issue: pass --issue or run inside an active checkpoint', 2);
    if (pos[1] === 'post') {
      const kind = pos[2];
      const markers = { contract: cp.CONTRACT_MARKER, checkpoint: cp.MARKER, evidence: null };
      if (!(kind in markers)) fail('linear post contract|checkpoint|evidence', 2);
      let body;
      if (kind === 'contract') body = cp.renderContract(c.contract.snapshot);
      else if (kind === 'checkpoint') body = cp.render(c);
      else body = readInput(opt.file || '-');
      const problems = checkPublishable(body);
      if (problems.length) fail(`refusing to post: ${problems.join('; ')}`);
      // The contract comment is never edited after posting: an edit would make
      // any approval of it stale, so a changed contract is a new comment.
      const r = await upsertComment(effective, process.env, stateDir(), issue, body, { marker: kind === 'checkpoint' ? markers.checkpoint : null, repository: c?.task?.repository || repoSlug(repoRoot()) });
      return out(r, `${r.action} ${kind} comment on ${issue}: ${r.url}`);
    }
    if (pos[1] === 'show') {
      const { issue: i, comments } = await fetchIssue(effective, issue, process.env);
      return out({ ...i, comments: comments.map((x) => ({ id: x.id, at: x.createdAt, author: x.botActor ? `integration:${x.botActor.name}` : x.user?.id, body: x.body })) });
    }
    if (pos[1] === 'status') {
      const r = await setIssueState(effective, process.env, stateDir(), issue, pos.slice(2).join(' '));
      return out(r, `${issue} is now ${r.state}`);
    }
    fail('linear post|status', 2);
  },

  async approval() {
    const { effective } = config();
    const c = loadCheckpoint();
    const issueKey = opt.issue || c.task.issue_key;
    const { issue, comments } = await fetchIssue(effective, issueKey, process.env);
    const owners = effective.authority?.owners?.map((o) => o.linear_user_id) || [];
    const binding = await checkBinding(effective, process.env);
    const risk = await credentialRisk(effective, process.env, binding, owners);
    if (risk) fail(`approval cannot be verified: ${risk}`);
    const keyState = binding_owner(effective, binding) ? 'safe: read-only (Linear refused a write probe), so approvals by its owner cannot be forged through it' : 'not an approval owner';
    const result = verifyApproval({ issue, comments, owners, expectedRevision: c.contract.revision, workspace: issue.workspace_id });
    c.task.issue_id = issue.id;
    c.task.workspace_id = issue.workspace_id;
    if (pos[1] === 'verify') {
      const applied = applyApproval(c, result);
      saveCheckpoint(c);
      out({ ...result, applied, verification_key: keyState }, `approval: ${result.status}${result.reason ? ` (${result.reason})` : ''}${result.status === 'approved' ? `; event ${result.event_id} by owner ${result.actor_id}; verification key: ${keyState}. This result is authoritative.` : ''}`);
      if (result.status !== 'approved') process.exitCode = 1;
      return;
    }
    if (pos[1] === 'authorize') {
      const r = authorizeAction(c, result, { action: pos[2], repository: opt.repository, environment: opt.environment, authority: effective.authority || {} });
      out(r, r.ok ? `authorized: ${pos[2]}` : `NOT AUTHORIZED: ${r.reason}`);
      if (!r.ok) process.exitCode = 1;
      return;
    }
    fail('approval verify|authorize', 2);
  },

  async review() {
    const { effective } = config();
    const c = loadCheckpoint(false);
    const implementer = opt.implementer || c?.execution?.implementer || detectSession().harness || harnessForStep(effective, 'implement');
    const available = opt.available
      ? opt.available.split(',')
      : Object.keys(effective.adapters).filter((id) => effective.adapters[id].enabled !== false && adapterFor(effective, id).authCheck(reviewerEnv()).ok);
    // An explicit --reviewer goes through the same policy as a configured one.
    const reviewConfig = opt.reviewer ? { ...effective, harness: { ...effective.harness, review: { ...effective.harness.review, reviewer: opt.reviewer } } } : effective;
    const selection = selectReviewer({ config: reviewConfig, implementer, available });
    if (pos[1] === 'select') return out({ implementer, ...selection });
    if (pos[1] !== 'run') fail('review select|run', 2);
    if (selection.blocked) {
      if (c) {
        cp.setStage(c, 'blocked', `review: ${selection.reason}`);
        saveCheckpoint(c);
      }
      fail(`review blocked: ${selection.reason}`);
    }
    if (!opt.base || !opt.head) fail('review run --base <ref> --head <ref>', 2);
    const contract = c?.contract?.snapshot || (opt.contract ? JSON.parse(readInput(opt.contract)) : null);
    if (!contract) fail('no contract: run within an active checkpoint or pass --contract <file>');
    const constraints = join(repoRoot(), effective.documents.constraints);
    const r = await runReview({ repoRoot: repoRoot(), config: effective, reviewer: selection.harness, implementer, base: opt.base, head: opt.head, contract, constraintsPath: existsSync(constraints) ? effective.documents.constraints : null, scope: contract.scope, stateDir: stateDir() });
    if (c && r.status !== 'refused') {
      c.reviews.push({ review_id: r.review_id, reviewer: r.reviewer, head: r.head, status: r.status, reason: r.reason || null, verdict: r.verdict || null, record_path: r.record_path });
      for (const f of r.findings || []) c.findings.push(f);
      if (['exhausted', 'auth-failed', 'timeout', 'unavailable', 'incomplete', 'refused', 'error'].includes(r.status)) {
        const fb = r.status === 'exhausted' && fallbackAllowed(effective, 'review');
        cp.setStage(c, 'blocked', `review by ${selection.harness}: ${r.status}${fb ? ' (fallback enabled for review; rerun with an explicit --reviewer)' : '; waiting (fallback not enabled)'}`);
      }
      saveCheckpoint(c);
    }
    out(r, `review ${r.status} by ${selection.harness}${r.reviewer?.model ? ` (${r.reviewer.model})` : ''} at ${r.head?.slice(0, 12)}: ${r.findings?.length ?? 0} finding(s)${r.reason ? ` — ${r.reason}` : ''}\nrecord: ${r.record_path}`);
    if (!['clean', 'findings'].includes(r.status)) process.exitCode = 1;
  },

  async browser() {
    const { effective } = config();
    const v = effective.verification;
    if (pos[1] === 'doctor') return out(doctor(repoRoot(), { browser: v.browser }));
    if (pos[1] === 'cleanup') return out({ cleaned: cleanupAbandoned(join(repoRoot(), '.stroppers', 'artifacts')) });
    if (pos[1] === 'prepare') {
      const r = prepare(repoRoot(), { browser: v.browser });
      out(r);
      if (r.status !== 'ready') process.exitCode = 1;
      return;
    }
    if (pos[1] === 'run') {
      const runId = `run-${new Date().toISOString().replace(/[-:.TZ]/g, '').slice(0, 14)}-${Math.random().toString(36).slice(2, 6)}`;
      const r = await runBrowserVerification({ repoRoot: repoRoot(), runId, browser: v.browser, headless: v.headless, maxMinutes: v.max_run_minutes, grep: opt.grep, artifactsRoot: join(repoRoot(), '.stroppers', 'artifacts') });
      out(r);
      if (r.status !== 'passed') process.exitCode = 1;
      return;
    }
    fail('browser doctor|prepare|run', 2);
  },

  evidence() {
    if (pos[1] !== 'publish' || !opt.run || !opt.pr) fail('evidence publish --run <run-id> --pr <number>', 2);
    const runDir = join(repoRoot(), '.stroppers', 'artifacts', opt.run);
    const record = JSON.parse(readFileSync(join(runDir, 'record.json'), 'utf8'));
    const c = loadCheckpoint(false);
    const repo = repoSlug(repoRoot());
    // Videos and a sanitized summary are published. Raw Playwright reports and
    // traces stay in the run directory: they can hold local paths, headers or
    // tokens. Publish a trace deliberately with --include-traces after checking it.
    writeFileSync(join(runDir, 'summary.json'), publishableSummary(record));
    const files = [...record.videos, 'summary.json', ...(opt['include-traces'] ? record.traces : [])];
    const body0 = renderIndex({ record, criteria: [], assets: [], environment: opt.environment });
    const pre = checkPublishable(body0);
    if (pre.length) fail(`refusing to publish: ${pre.join('; ')}`);
    const assets = uploadAssets({ repo, runDir, files, runId: opt.run });
    const unresolved = assets.filter((a) => !a.url);
    if (unresolved.length) fail(`uploaded assets without a resolvable URL: ${unresolved.map((a) => a.name).join(', ')}; nothing was posted`);
    const criteria = (c?.verification_plan || []).map((p) => ({ id: p.criterion_id, criterion: p.criterion, method: p.method, status: c.outcomes[p.criterion_id]?.status || 'unverified', reason: c.outcomes[p.criterion_id]?.reason || (c.outcomes[p.criterion_id] ? '' : 'not yet run') }));
    const body = renderIndex({ record, criteria, assets, environment: opt.environment });
    const problems = checkPublishable(body);
    if (problems.length) fail(`refusing to publish: ${problems.join('; ')}`);
    const bodyFile = join(runDir, 'index.md');
    writeFileSync(bodyFile, body);
    const url = postComment(repo, opt.pr, bodyFile);
    if (c) {
      c.evidence.push({ kind: 'browser-run', run_id: opt.run, revision: record.revision, status: record.status, index_url: url, assets: assets.map((a) => a.url) });
      saveCheckpoint(c);
    }
    out({ index_url: url, assets }, `published ${assets.length} asset(s); index: ${url}`);
  },

  install() {
    out(install(repoRoot(), { cloudEntry: opt['cloud-entry'], ref: opt.ref }));
  },
  update() {
    out(install(repoRoot(), { cloudEntry: opt['cloud-entry'], ref: opt.ref }));
  },
  uninstall() {
    out(uninstall(repoRoot()));
  },
  'install-status'() {
    out(installStatus(repoRoot()));
  },
};

if (!pos[0] || opt.help || pos[0] === 'help') {
  console.log(USAGE);
  process.exit(pos[0] ? 0 : 2);
}
const command = commands[pos[0]];
if (!command) fail(`unknown command ${pos[0]}\n\n${USAGE}`, 2);
try {
  await command();
} catch (e) {
  fail(e.message);
}
